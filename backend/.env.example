# ============================================================
#  CONTATECK backend · Variables de entorno
#  Copia este archivo como .env (local) o pégalas en Railway.
# ============================================================

# ---- Fiscalapi (PAC) ----
# PRUEBAS:    https://test.fiscalapi.com
# PRODUCCIÓN: https://live.fiscalapi.com
FISCALAPI_URL=https://test.fiscalapi.com
FISCALAPI_KEY=sk_test_cb2a57ca_ca64_4e3b_99a5_ed7a1b9424d5
FISCALAPI_TENANT=aaa501cb-1bb3-47cf-864b-cd6a4ad67082

# ---- Emisor (TU RFC y CSD reales · SOLO para PRODUCCIÓN) ----
# Si dejas estas vacías, el backend usa el CSD público de PRUEBAS
# (ESCUELA KEMPER URGATE). Para facturar de verdad con TU RFC, llénalas TODAS.
# El CSD va en base64: en tu compu corre  ->  certutil -encode archivo.cer cer.b64
# (Windows) o  ->  base64 -w0 archivo.cer  (Linux/Mac), y pega el resultado.
# EMISOR_REGIMEN: persona física suele ser 612 o 626 (RESICO). NUNCA 601.
# EMISOR_RFC=XAXX010101000
# EMISOR_NOMBRE=NOMBRE COMPLETO COMO EN EL SAT
# EMISOR_REGIMEN=612
# EMISOR_CP=75700
# EMISOR_CSD_CER=MIIF...   (contenido .cer en base64, una sola línea)
# EMISOR_CSD_KEY=MIIE...   (contenido .key en base64, una sola línea)
# EMISOR_CSD_PASSWORD=tu_contraseña_del_csd

# ---- Seguridad ----
# false para la primera prueba; true en producción (exige login válido de Supabase Auth).
REQUIRE_AUTH=false

# Dominios que pueden llamar al backend (separados por coma).
# Ej: https://teccapitalweb.github.io
ALLOWED_ORIGINS=*

# ---- Firebase Admin (opcional al inicio) ----
# Pega TODO el JSON del service account en UNA línea, entre comillas simples.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar clave privada.
# Se conserva mientras Firestore siga en uso (OT-0004 no migra datos, solo Auth).
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"contateck-79760", ...}'

# ---- Supabase Auth (OT-0004) ----
# Supabase > tu proyecto > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY es secreta: nunca se pega en el frontend, solo aquí.
# SUPABASE_URL=https://ctwmrsgqczaqenxbnobd.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=pega_aqui_la_service_role_key

# Railway define PORT automáticamente; en local usa 8080.
PORT=8080
